{
  "expo": {
    "name": "Home Monitor",
    "slug": "home-automation-mobile",
    "version": "0.1.2",
    "ios": {
      "bundleIdentifier": "com.toddkimery.homeautomationmobile",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Connect to your dryer sensor on your Wi-Fi network.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.toddkimery.homeautomationmobile",
      "versionCode": 3
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-secure-store"
    ]
  }
}
