{
  "expo": {
    "name": "Home Monitor",
    "slug": "home-automation-mobile",
    "version": "0.1.5",
    "ios": {
      "bundleIdentifier": "com.toddkimery.homeautomationmobile",
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Connect to your dryer sensor on your Wi-Fi network.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.toddkimery.homeautomationmobile",
      "versionCode": 6,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/adaptive-foreground.png",
        "monochromeImage": "./assets/icons/adaptive-monochrome.png",
        "backgroundColor": "#111918"
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-secure-store"
    ],
    "icon": "./assets/icons/launcher.png"
  }
}
